{
  "name": "dsh-opencode-go-quota",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenCode Go quota in the DeepSeek Harness sidebar: rolling 5-hour, weekly and monthly usage percents with reset countdowns, read from OpenCode's official usage API.",
  "license": "MIT",
  "author": "kangzichen",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "quota",
    "usage",
    "sidebar",
    "widget"
  ],
  "engines": {
    "node": ">=20"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
